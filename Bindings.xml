<Bindings>
	<!--
		Click-binding the One-Key Disenchant SecureActionButton. The button
		itself is created at PLAYER_LOGIN with the name AutoDeleteDisenchantButton.
		`CLICK <name>:LeftButton` is the WoW 3.3.5a binding-system syntax that
		routes a keypress to a synthetic left-click on the named secure button.
		The macrotext attribute is rewritten by addon code between presses to
		point at the next disenchantable bag slot.

		Display strings (BINDING_HEADER_AUTODELETE, BINDING_NAME_*) are set on
		the global table in AutoDelete.lua so they can be localized later if we
		ever need to. The header groups our bindings under "AutoDelete" in the
		Key Bindings UI.
	-->
	<Binding name="CLICK AutoDeleteDisenchantButton:LeftButton" header="AUTODELETE">
	</Binding>
</Bindings>
